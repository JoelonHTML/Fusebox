<Page x:Class="Fusebox.App.Pages.DetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Detail screen of one Live metric (FEATURES.md §3.8). Built in code (DetailPage.Build): header, headline, 5 min | 1 hour | Today,
         graph card, Min / Average / Max, peaks, per-metric cards. -->
    <Grid x:Name="Root" SizeChanged="Root_SizeChanged">
        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Padding="14,0,14,14" Spacing="12" />
        </ScrollViewer>
    </Grid>
</Page>
