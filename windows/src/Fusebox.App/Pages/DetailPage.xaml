<Page x:Class="Fusebox.App.Pages.DetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:Fusebox.App.Controls">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="BackButton" Click="Back_Click" ToolTipService.ToolTip="Live" AutomationProperties.Name="Live">
                    <FontIcon Glyph="&#xE72B;" />
                </Button>
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="ValueText" FontSize="40" FontWeight="SemiBold" />
                <TextBlock x:Name="UnitText" Opacity="0.7" VerticalAlignment="Bottom" Margin="0,0,0,8" />
            </StackPanel>
            <RadioButtons x:Name="PeriodPick" MaxColumns="3" SelectionChanged="Period_Changed">
                <RadioButton Tag="0" />
                <RadioButton Tag="1" />
                <RadioButton Tag="2" />
            </RadioButtons>
            <Border Style="{StaticResource FuseboxCard}">
                <Grid>
                    <c:Sparkline x:Name="Graph" Height="180" />
                    <TextBlock x:Name="Collecting" Text="Collecting data…" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Border>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Min" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="MinText" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Average" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="AvgText" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Max" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock x:Name="MaxText" Style="{StaticResource BodyStrongTextBlockStyle}" /></StackPanel>
            </Grid>
            <Border x:Name="CoresCard" Style="{StaticResource FuseboxCard}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CoresTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid x:Name="CoreGrid" ColumnSpacing="16" RowSpacing="4" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FuseboxCard}">
                <StackPanel x:Name="FactsPanel" Spacing="6" />
            </Border>
            <Border x:Name="PeaksCard" Style="{StaticResource FuseboxCard}" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="Peaks" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel x:Name="PeaksPanel" Spacing="2" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
