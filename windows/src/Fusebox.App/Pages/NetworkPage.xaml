<Page x:Class="Fusebox.App.Pages.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <StaticResource x:Key="GoodBrush" ResourceKey="FuseboxGood" />
        <StaticResource x:Key="BadBrush" ResourceKey="FuseboxBad" />
        <StaticResource x:Key="WarnBrush" ResourceKey="FuseboxWarning" />
    </Page.Resources>
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="940" HorizontalAlignment="Stretch">
            <TextBlock Text="Network" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Connection -->
            <Border Style="{StaticResource FuseboxCard}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Connection" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="ConnText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>

            <!-- Wi-Fi (hidden when there is no Wi-Fi adapter) -->
            <Border x:Name="WifiCard" Style="{StaticResource FuseboxCard}" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="Wi-Fi" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="WifiText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="WifiHint" TextWrapping="Wrap" Opacity="0.75" Visibility="Collapsed"
                               Text="Allow location access to see the Wi-Fi name" />
                    <Button x:Name="WifiLocationButton" Content="Open location settings" Click="WifiLocationClick" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Find the problem -->
            <Border Style="{StaticResource FuseboxCard}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="FindButton" Content="Find the problem" Click="FindClick" />
                        <ProgressRing x:Name="FindRing" Width="20" Height="20" IsActive="False" />
                    </StackPanel>
                    <TextBlock x:Name="FindVerdict" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" Visibility="Collapsed" />
                    <TextBlock x:Name="FindNumbers" TextWrapping="Wrap" Opacity="0.75" Visibility="Collapsed" />
                    <StackPanel x:Name="StepsPanel" Spacing="4" />
                </StackPanel>
            </Border>

            <!-- Speed test -->
            <Border Style="{StaticResource FuseboxCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Speed test" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="QuickButton" Content="Quick" Click="QuickClick" />
                        <Button x:Name="FullButton" Content="Full" Click="FullClick" />
                        <Button x:Name="SpeedCancelButton" Content="Cancel" Click="SpeedCancelClick" Visibility="Collapsed" />
                        <Button x:Name="IpButton" Content="Show public IP" Click="IpClick" />
                    </StackPanel>
                    <ProgressBar x:Name="SpeedBar" Minimum="0" Maximum="1" Visibility="Collapsed" />
                    <TextBlock x:Name="SpeedPhase" TextWrapping="Wrap" Opacity="0.75" Visibility="Collapsed" />
                    <TextBlock x:Name="SpeedResultText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" />
                    <TextBlock x:Name="IpText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Devices -->
            <Border Style="{StaticResource FuseboxCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Devices" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RangeBox" Grid.Column="0" Header="Scan range" PlaceholderText="This network (auto), or 192.168.1.0/24 or 192.168.1.10-80" TextChanged="RangeChanged" />
                        <Button x:Name="ScanButton" Grid.Column="1" Content="Scan" VerticalAlignment="Bottom" Click="ScanClick" />
                    </Grid>
                    <TextBlock x:Name="RangeNote" TextWrapping="Wrap" Opacity="0.75" Visibility="Collapsed" />
                    <TextBox x:Name="SearchBox" PlaceholderText="Search" TextChanged="SearchChanged" />
                    <TextBlock x:Name="ScanStatus" TextWrapping="Wrap" Opacity="0.75" Text="Press Scan to look for devices" />
                    <Grid x:Name="HeaderRow" ColumnSpacing="8" Padding="12,0,12,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Opacity="0.75" />
                        <TextBlock Grid.Column="1" Text="IP address" Opacity="0.75" />
                        <TextBlock Grid.Column="2" Text="Vendor" Opacity="0.75" />
                        <TextBlock Grid.Column="3" Text="Type" Opacity="0.75" />
                        <TextBlock Grid.Column="4" Text="ms" Opacity="0.75" />
                    </Grid>
                    <ListView x:Name="DeviceList" MaxHeight="420" SelectionMode="Single" SelectionChanged="DeviceSelected" />
                    <StackPanel x:Name="DetailPanel" Spacing="4" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
