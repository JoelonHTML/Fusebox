<Page x:Class="Fusebox.App.Pages.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:Fusebox.App.Controls">

    <!-- One scroll area: the three cards (Connection, Wi-Fi, Speed test), then the Devices section. The Devices header (title + count, toolbar,
         blocked hint, column header) is moved into PinnedHost once it scrolls out of view, so it stays at the top while the rows scroll.
         Everything inside is built in code. -->
    <Grid x:Name="Root" SizeChanged="RootSizeChanged">
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" ViewChanged="PageScrollViewChanged">
            <StackPanel x:Name="PageBody" Padding="12,0,14,10" Spacing="14">
                <Grid x:Name="CardsHost" />
                <StackPanel x:Name="DevicesSection">
                    <Grid x:Name="HeaderSlot">
                        <StackPanel x:Name="DevicesHeader" Spacing="8" Padding="0,4,0,6">
                            <StackPanel x:Name="TitleRow" Orientation="Horizontal" Spacing="8" />
                            <Grid x:Name="Toolbar" ColumnSpacing="8" />
                            <Grid x:Name="BlockedHint" ColumnSpacing="6" Visibility="Collapsed" />
                            <Grid x:Name="HeaderRow" ColumnSpacing="8" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="DeviceList" />
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,20,0,20" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border x:Name="PinnedHost" VerticalAlignment="Top" Padding="12,0,14,0" Visibility="Collapsed" />
    </Grid>
</Page>
