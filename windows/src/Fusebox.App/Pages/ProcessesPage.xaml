<Page x:Class="Fusebox.App.Pages.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:Fusebox.App.Controls">
    <Page.Resources>
        <!-- Flat button: no hover/pressed chrome (the Mac list has no hover highlight); keyboard focus keeps the system focus visual. -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Filter chip (§4.4): accent text on 15 % accent when selected, secondary text otherwise; no hover state. -->
        <Style x:Key="ProcChip" TargetType="ToggleButton">
            <Setter Property="Padding" Value="7,3,7,3" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Find_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="Root" Padding="12,6,12,10" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="PaneColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="ListSide" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="Summary" c:Look.Label="11" Foreground="{ThemeResource FuseboxSecondary}" TextTrimming="CharacterEllipsis" />

            <Grid x:Name="Bar" Grid.Row="1" ColumnSpacing="8" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="2" />
                <TextBox x:Name="SearchBox" Grid.Column="1" MinWidth="110" PlaceholderText="Search apps" TextChanged="Search_TextChanged" />
            </Grid>

            <Grid x:Name="Header" Grid.Row="2" />

            <ScrollViewer x:Name="Scroller" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel>
                    <StackPanel x:Name="Rows" />
                    <TextBlock x:Name="Empty" c:Look.Label="12" Foreground="{ThemeResource FuseboxSecondary}" Padding="0,20,0,20" Visibility="Collapsed" Text="Nothing found" />
                    <Button x:Name="ShowAll" Style="{StaticResource FlatButton}" HorizontalAlignment="Center" Padding="8,8,8,8" Visibility="Collapsed" Click="ShowAll_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Split pane (≥ 1100 DIPs): the selected row's details in one themed card. -->
        <ScrollViewer x:Name="Pane" Grid.Column="1" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed" Padding="0" />
    </Grid>
</Page>
