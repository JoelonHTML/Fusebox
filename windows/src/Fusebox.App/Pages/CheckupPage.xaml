<Page x:Class="Fusebox.App.Pages.CheckupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows Settings calm: one card per group (built in code, Ui.Surface), spacing instead of lines, content at most 1000 wide and centred. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Body" Padding="16,8,16,24" Spacing="12" MaxWidth="1032">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SelectorBar x:Name="PeriodBar" SelectionChanged="OnPeriod" />
                <Button x:Name="ReloadBtn" Grid.Column="1" Click="OnReload" Padding="8" MinWidth="0" MinHeight="0" CornerRadius="4"
                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                    <FontIcon x:Name="ReloadIcon" Glyph="&#xE72C;" FontSize="14" Foreground="{ThemeResource FuseboxSecondary}" />
                </Button>
            </Grid>
            <StackPanel x:Name="ScoreHost" Spacing="12" />
            <StackPanel x:Name="GroupsHost" Spacing="8" />
            <StackPanel x:Name="ExportHost" />
        </StackPanel>
    </ScrollViewer>
</Page>
