<Page x:Class="Fusebox.App.Pages.CheckupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <!-- The five groups are plain Fluent Expanders: transparent header/content, a 1 px theme line on top (Mac: 1 pt separator), hover from the theme. -->
        <ResourceDictionary>
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
            <Thickness x:Key="ExpanderContentPadding">0,2,0,0</Thickness>
            <Thickness x:Key="ExpanderHeaderPadding">0,0,0,0</Thickness>
        </ResourceDictionary>
    </Page.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Body" Padding="16,6,16,20" Spacing="10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SelectorBar x:Name="PeriodBar" SelectionChanged="OnPeriod" />
                <Button x:Name="ReloadBtn" Grid.Column="1" Click="OnReload" Padding="8,6,8,6" MinWidth="0" MinHeight="0"
                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                    <FontIcon x:Name="ReloadIcon" Glyph="&#xE72C;" FontSize="14" Foreground="{ThemeResource FuseboxSecondary}" />
                </Button>
            </Grid>
            <StackPanel x:Name="ScoreHost" Spacing="10" />
            <StackPanel x:Name="GroupsHost" Spacing="0" />
            <StackPanel x:Name="ExportHost" />
        </StackPanel>
    </ScrollViewer>
</Page>
