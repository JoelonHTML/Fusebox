<Page x:Class="Fusebox.App.Pages.CheckupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12">
            <StackPanel x:Name="Header" Spacing="12">
                <TextBlock Text="Checkup" Style="{StaticResource TitleTextBlockStyle}" />
                <Border Style="{StaticResource FuseboxCard}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock x:Name="ScoreText" Text="–" FontSize="48" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Health score" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="ScoreSub" Opacity="0.7" />
                        </StackPanel>
                        <Button x:Name="CopyBtn" Content="Copy report" Click="OnCopy" VerticalAlignment="Center" />
                        <Button x:Name="RefreshBtn" Content="Refresh" Click="OnRefresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel x:Name="Sections" Spacing="12" />
            <!-- Theme-aware brushes for code-behind: read from these swatches instead of looking up theme dictionaries. -->
            <Rectangle x:Name="GoodSwatch" Fill="{ThemeResource FuseboxGood}" Visibility="Collapsed" />
            <Rectangle x:Name="WarnSwatch" Fill="{ThemeResource FuseboxWarning}" Visibility="Collapsed" />
            <Rectangle x:Name="BadSwatch" Fill="{ThemeResource FuseboxBad}" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
