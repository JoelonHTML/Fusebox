<Page x:Class="Fusebox.App.Pages.DockedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12">
            <Grid>
                <TextBlock Text="Docked" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="RefreshButton" Content="Refresh" HorizontalAlignment="Right" Click="OnRefresh" />
            </Grid>

            <!-- Only here to hand its themed Foreground to rows built in code. -->
            <TextBlock x:Name="WarnProbe" Visibility="Collapsed" Foreground="{ThemeResource FuseboxWarning}" />

            <Border Style="{StaticResource FuseboxCard}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Power in" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="PowerText" TextWrapping="Wrap" />
                    <TextBlock Text="Windows doesn't share charger and cable details with apps."
                               Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource FuseboxCard}">
                <StackPanel Spacing="6">
                    <TextBlock Text="USB" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel x:Name="UsbList" Spacing="6" />
                </StackPanel>
            </Border>

            <Border x:Name="DisplaysCard" Style="{StaticResource FuseboxCard}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Displays" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel x:Name="DisplayList" Spacing="6" />
                </StackPanel>
            </Border>

            <Border x:Name="BluetoothCard" Style="{StaticResource FuseboxCard}" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock Text="Bluetooth" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel x:Name="BluetoothList" Spacing="6" />
                </StackPanel>
            </Border>

            <Border x:Name="AudioCard" Style="{StaticResource FuseboxCard}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Audio" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel x:Name="AudioList" Spacing="6" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
