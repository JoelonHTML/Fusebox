<Page x:Class="Fusebox.App.Pages.AppPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:Fusebox.App.Controls">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="960" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="BackBtn" Click="Back_Click" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Back" />
                <Image x:Name="IconImg" Width="32" Height="32" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="SubText" Opacity="0.7" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="StatusText" Style="{StaticResource BodyStrongTextBlockStyle}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource FuseboxCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="CPU" Opacity="0.7" />
                        <TextBlock x:Name="CpuNow" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <c:Sparkline x:Name="CpuSpark" Height="56" />
                        <TextBlock x:Name="CpuStats" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource FuseboxCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="RAM" Opacity="0.7" />
                        <TextBlock x:Name="RamNow" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <c:Sparkline x:Name="RamSpark" Height="56" />
                        <TextBlock x:Name="RamStats" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource FuseboxCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="GPU" Opacity="0.7" />
                        <TextBlock x:Name="GpuNow" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <c:Sparkline x:Name="GpuSpark" Height="56" />
                        <TextBlock x:Name="GpuStats" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="Average and peak count from when Fusebox started watching this app (the last hour is graphed). Fusebox keeps this in memory only." Opacity="0.7" TextWrapping="Wrap" />

            <Border Style="{StaticResource FuseboxCard}">
                <StackPanel x:Name="Facts" Spacing="6" />
            </Border>

            <StackPanel x:Name="WhatPanel" Spacing="6" />

            <Button x:Name="StopBtn" Content="✕ Stop" Click="Stop_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
