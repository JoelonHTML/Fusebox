<Window x:Class="Fusebox.App.TrayPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fusebox">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid Padding="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="Rows" Spacing="6" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
            <Button x:Name="OpenButton" Click="Open_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="QuitButton" Click="Quit_Click" />
        </StackPanel>
    </Grid>
</Window>
