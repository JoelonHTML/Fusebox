<!-- Shared look. Pages use these keys only, so the Settings page can swap styles (Glass, Minimal light, Color blocks, Instrument, Terminal)
     by replacing this dictionary's values at runtime. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="FuseboxCardBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="FuseboxCardBorder" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="FuseboxGraphStroke" ResourceKey="AccentFillColorDefaultBrush" />
            <SolidColorBrush x:Key="FuseboxWarning" Color="#F7B500" />
            <SolidColorBrush x:Key="FuseboxBad" Color="#E5484D" />
            <SolidColorBrush x:Key="FuseboxGood" Color="#30A46C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="FuseboxCardBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="FuseboxCardBorder" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="FuseboxGraphStroke" ResourceKey="AccentFillColorDefaultBrush" />
            <SolidColorBrush x:Key="FuseboxWarning" Color="#B07A00" />
            <SolidColorBrush x:Key="FuseboxBad" Color="#CE2C31" />
            <SolidColorBrush x:Key="FuseboxGood" Color="#218358" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <CornerRadius x:Key="FuseboxCardCornerRadius">8</CornerRadius>
    <Thickness x:Key="FuseboxCardPadding">16,12,16,12</Thickness>
    <FontFamily x:Key="FuseboxFont">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="FuseboxMonoFont">Cascadia Mono, Consolas</FontFamily>
    <Style x:Key="FuseboxCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FuseboxCardBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FuseboxCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FuseboxCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource FuseboxCardPadding}" />
    </Style>
</ResourceDictionary>
