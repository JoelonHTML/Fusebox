<Window x:Class="Fusebox.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings">
    <!-- System look (Mica, Fluent controls); follows only the Light/Dark choice. Sidebar items are built in code (SettingsWindow.Tabs). -->
    <Grid x:Name="Root">
        <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" OpenPaneLength="200" IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="Nav_SelectionChanged">
            <Frame x:Name="Host" />
        </NavigationView>
    </Grid>
</Window>
