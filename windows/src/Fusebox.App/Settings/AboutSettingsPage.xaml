<Page x:Class="Fusebox.App.Settings.AboutSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:s="using:Fusebox.App.Settings">
    <!-- Settings › About (FEATURES.md §9.16). Add rows to Body: <s:SettingsCard Header="…" Description="…"><ToggleSwitch /></s:SettingsCard>,
         section headers: <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="…" />. -->
    <!-- Windows Settings layout: the title stays put, the rows scroll under it; content at most 1000 wide, centred; rows 4 apart. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="About" Style="{StaticResource SettingsPageTitle}" Margin="36,28,36,16" MaxWidth="1000" />
        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="Body" Padding="36,0,36,36" Spacing="4" MaxWidth="1072" />
        </ScrollViewer>
    </Grid>
</Page>
