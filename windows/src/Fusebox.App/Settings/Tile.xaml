<UserControl x:Class="Fusebox.App.Settings.Tile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="True" UseSystemFocusVisuals="True">
    <!-- Selectable tile, one style for every preview (theme, text size, font, tray style, graphs, profile): radius 8, padding 8, a calm fill
         and 1 px subtle stroke; selected = 2 px accent ring. The ring is a second border on top so the layout never jumps. Theme resources,
         so it follows the Settings window's light/dark. -->
    <Grid>
        <Border x:Name="Face" CornerRadius="8" Padding="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ContentPresenter x:Name="Host" />
        </Border>
        <Border x:Name="Ring" CornerRadius="8" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" />
    </Grid>
</UserControl>
