<UserControl x:Class="Fusebox.App.Settings.ToastMock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Mini Windows notification (Mac NotificationExample, §9.3): app icon 20, title semibold 12, body 12 secondary. -->
    <Border CornerRadius="8" Padding="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/Fusebox-256.png" Width="20" Height="20" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="BodyText" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
