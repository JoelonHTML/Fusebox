<UserControl x:Class="Fusebox.App.Settings.SettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One row like Windows Settings: optional icon · header + description · trailing control (the card's content). -->
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="4" Padding="16,10,16,10" MinHeight="64">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="Icon" FontSize="20" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="HeaderText" TextWrapping="Wrap" />
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ContentPresenter x:Name="ActionHost" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
    </Border>
</UserControl>
