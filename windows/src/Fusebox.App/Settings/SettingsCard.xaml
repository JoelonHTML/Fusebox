<UserControl x:Class="Fusebox.App.Settings.SettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One row like Windows 11 Settings (SettingsCard): radius 4, card fill, 1 px subtle stroke, min 66 high, icon 16 · header +
         description · trailing control. Optional content below the row (tile grids, previews); without a header only that content shows. -->
    <Border x:Name="Frame" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="4" Padding="16,0,16,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="Head" MinHeight="66" Padding="0,10,0,10" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="Icon" FontSize="16" Width="20" Margin="2,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                <StackPanel x:Name="Texts" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" TextWrapping="Wrap" />
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <ContentPresenter x:Name="ActionHost" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <ContentPresenter x:Name="BelowHost" Grid.Row="1" Margin="0,0,0,16" Visibility="Collapsed" HorizontalContentAlignment="Stretch" />
        </Grid>
    </Border>
</UserControl>
