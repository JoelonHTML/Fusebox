/* Network tab (Windows-only wording) — es */
"Domain (a work network)" = "Dominio (una red de trabajo)";
"Encrypted DNS" = "DNS cifrado";
"Private (a trusted network, this PC can be found)" = "Privada (una red de confianza, este PC puede encontrarse)";
"Public (this PC hides from other devices)" = "Pública (este PC se oculta de otros dispositivos)";
"Windows is blocking the scan. Allow Fusebox in Windows Security under Firewall & network protection, then press Scan." = "Windows está bloqueando el escaneo. Permite Fusebox en Seguridad de Windows, en Firewall y protección de red, y pulsa Escanear.";
"Yes: Windows and apps may hold back big downloads" = "Sí: Windows y las apps pueden aplazar descargas grandes";
"this network (found automatically)" = "esta red (encontrada automáticamente)";
"Save report…" = "Guardar informe…";
"Network report" = "Informe de red";
"Contains no Wi-Fi name, network addresses, computer name or user name." = "No contiene el nombre de la wifi, direcciones de red, nombre del equipo ni nombre de usuario.";
"A PDF with signal, ping and speed numbers and graphs to send to your provider or helpdesk. No Wi-Fi name or addresses." = "Un PDF con valores de señal, ping y velocidad y gráficos para enviar a tu proveedor o al soporte. Sin nombre de wifi ni direcciones.";
"Cloudflare is limiting speed tests from your connection right now. Try again in %lld min." = "Cloudflare está limitando ahora las pruebas de velocidad desde tu conexión. Vuelve a intentarlo en %lld min.";
"Cloudflare's speed test didn't accept the test (error %lld). Try again later." = "La prueba de velocidad de Cloudflare rechazó la prueba (error %lld). Vuelve a intentarlo más tarde.";
"No connection to Cloudflare's speed test. Check your internet connection and try again." = "No hay conexión con la prueba de velocidad de Cloudflare. Comprueba tu conexión a internet y vuelve a intentarlo.";
