/* Network tab (Windows-only wording) — de */
"Domain (a work network)" = "Domäne (ein Arbeitsnetzwerk)";
"Encrypted DNS" = "Verschlüsseltes DNS";
"Private (a trusted network, this PC can be found)" = "Privat (ein vertrauenswürdiges Netzwerk, dieser PC kann gefunden werden)";
"Public (this PC hides from other devices)" = "Öffentlich (dieser PC verbirgt sich vor anderen Geräten)";
"Windows is blocking the scan. Allow Fusebox in Windows Security under Firewall & network protection, then press Scan." = "Windows blockiert den Scan. Erlaube Fusebox in der Windows-Sicherheit unter Firewall- & Netzwerkschutz und drück dann „Scan“.";
"Yes: Windows and apps may hold back big downloads" = "Ja: Windows und Apps halten große Downloads evtl. zurück";
"this network (found automatically)" = "dieses Netzwerk (automatisch gefunden)";
"Save report…" = "Bericht speichern…";
"Network report" = "Netzwerkbericht";
"Contains no Wi-Fi name, network addresses, computer name or user name." = "Enthält keinen WLAN-Namen, keine Netzwerkadressen, keinen Computernamen und keinen Benutzernamen.";
"A PDF with signal, ping and speed numbers and graphs to send to your provider or helpdesk. No Wi-Fi name or addresses." = "Ein PDF mit Signal-, Ping- und Geschwindigkeitswerten und Diagrammen für Ihren Anbieter oder den Helpdesk. Ohne WLAN-Namen und Adressen.";
"Cloudflare is limiting speed tests from your connection right now. Try again in %lld min." = "Cloudflare begrenzt gerade Geschwindigkeitstests von deiner Verbindung. Versuche es in %lld Min. erneut.";
"Cloudflare's speed test didn't accept the test (error %lld). Try again later." = "Der Geschwindigkeitstest von Cloudflare hat den Test abgelehnt (Fehler %lld). Versuche es später erneut.";
"No connection to Cloudflare's speed test. Check your internet connection and try again." = "Keine Verbindung zum Geschwindigkeitstest von Cloudflare. Prüfe deine Internetverbindung und versuche es erneut.";
