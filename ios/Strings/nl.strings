/* Fusebox voor iPhone — Nederlands: teksten die alleen de iPhone-app heeft. De rest komt uit ../Resources/nl.lproj. */
"%@ of %@" = "%@ van %@";
"%@ · live" = "%@ · live";
"A bit warm. Nothing to do; the iPhone still runs at full speed." = "Een beetje warm. Je hoeft niets te doen; de iPhone werkt nog op volle snelheid.";
"A PDF with your connection, quality and speed tests, for a helpdesk or your provider. No network name, addresses or device names." = "Een pdf met je verbinding, kwaliteit en snelheidstests, voor een helpdesk of je provider. Zonder netwerknaam, adressen of apparaatnamen.";
"All good on mobile data: internet %@ ms, no packet loss" = "Alles goed op mobiele data: internet %@ ms, geen pakketverlies";
"An iPhone app can see whether the iPhone charges, where sound goes, and a connected display, keyboard, mouse, game controller or network adapter. It can't see the charger's power, cable details, USB drives or the battery of earbuds." = "Een iPhone-app kan zien of de iPhone oplaadt, waar het geluid heen gaat, en of er een beeldscherm, toetsenbord, muis, gamecontroller of netwerkadapter aan hangt. Niet te zien: het vermogen van de lader, kabelgegevens, USB-schijven en de batterij van oortjes.";
"An iPhone app can't see the processor, graphics chip, temperatures in degrees or other apps. Fusebox shows what iOS does share." = "Een iPhone-app kan de processor, de grafische chip, temperaturen in graden en andere apps niet zien. Fusebox toont wat iOS wel deelt.";
"Audio output" = "Geluidsuitvoer";
"Battery is low (%lld%%): charge soon" = "Batterij is bijna leeg (%lld%%): laad binnenkort op";
"Bluetooth audio" = "Bluetooth-geluid";
"Check ports tries 15 common ports (web, file sharing, printing, …). Rename and Forget only change Fusebox's own list on this iPhone." = "Controleer poorten probeert 15 veelgebruikte poorten (web, bestandsdeling, afdrukken, …). Wijzig naam en Vergeet veranderen alleen de eigen lijst van Fusebox op deze iPhone.";
"Connect to Wi-Fi to see the devices on your network" = "Verbind met wifi om de apparaten op je netwerk te zien";
"Connected" = "Verbonden";
"Cool enough to run at full speed." = "Koel genoeg om op volle snelheid te werken.";
"download — upload ┄ · last two minutes" = "download — upload ┄ · laatste twee minuten";
"Empty: Fusebox makes no internet connections until you start a speed test or Find the problem." = "Leeg: Fusebox maakt geen internetverbindingen tot je een snelheidstest of Zoek het probleem start.";
"External display" = "Extern beeldscherm";
"Free space on this iPhone, counted the way iOS does for important things (it can clear caches to make room). Below about 10% free, updates and the camera can run into trouble." = "Vrije ruimte op deze iPhone, geteld zoals iOS dat doet voor belangrijke dingen (het kan caches wissen om ruimte te maken). Onder ongeveer 10% vrij kunnen updates en de camera in de problemen komen.";
"Fusebox follows the language of your iPhone. You can pick another language just for Fusebox in the Settings app." = "Fusebox volgt de taal van je iPhone. In de app Instellingen kun je een andere taal kiezen alleen voor Fusebox.";
"Fusebox shows the name, address and kind of each device. An iPhone app can't see hardware addresses, so the maker isn't shown." = "Fusebox toont de naam, het adres en de soort van elk apparaat. Een iPhone-app kan geen hardware-adressen zien, dus de maker staat er niet bij.";
"Game controller" = "Gamecontroller";
"Hot" = "Heet";
"Hot: iOS slows the iPhone down and may dim the screen. Take it out of the sun or off the charger." = "Heet: iOS maakt de iPhone trager en kan het scherm dimmen. Haal hem uit de zon of van de lader.";
"How full the battery is and whether the iPhone is charging. iOS doesn't tell apps the battery's condition, charge cycles or the charger's power; you find the condition in Settings › Battery." = "Hoe vol de batterij is en of de iPhone oplaadt. iOS vertelt apps niets over de conditie van de batterij, laadcycli of het vermogen van de lader; de conditie vind je in Instellingen › Batterij.";
"How this iPhone is connected: Wi-Fi, mobile data or a cable adapter. Wi-Fi is usually faster and steadier than mobile data." = "Hoe deze iPhone verbonden is: wifi, mobiele data of een kabeladapter. Wifi is meestal sneller en stabieler dan mobiele data.";
"How warm the iPhone is, in the four steps iOS gives apps: normal, warm, hot and very hot. iOS doesn't share degrees." = "Hoe warm de iPhone is, in de vier stappen die iOS aan apps geeft: normaal, warm, heet en zeer heet. Graden deelt iOS niet.";
"iOS is blocking the scan. Allow Local Network for Fusebox in Settings, then press Scan." = "iOS blokkeert de scan. Sta Lokaal netwerk toe voor Fusebox in Instellingen en druk dan op Scan.";
"Line out" = "Lijnuitgang";
